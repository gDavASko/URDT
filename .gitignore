# ============================================================
# Unity project (root is both the git repo and the Unity project)
# ============================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Auto-generated solution/project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Gradle cache directory
.gradle/

# Rider / VS
.idea/
.vs/

# ============================================================
# URDT harness artifacts
# ============================================================
/.harness/
/test-results.xml
/CodeCoverage/
node_modules/
/.npm_cache/
/CoreAgent/tmp/

# URDT L3 local sense models and llama.cpp binaries (fetch with CoreAgent/scripts/fetch_models.sh)
/CoreAgent/models/*.gguf
/CoreAgent/models/*.onnx
/CoreAgent/tools/
# L3 task outputs (result.json, screenshots) — task definitions (*.json at the top level) stay tracked
/URDT_Sandbox/tasks/*/

/URDT_Sandbox/experiments/

# agent-side fallback when a game does not report its knowledge folder
/CoreAgent/knowledge/unbound/
