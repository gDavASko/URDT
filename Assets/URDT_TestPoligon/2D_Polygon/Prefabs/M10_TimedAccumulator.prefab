  m_Name: 
  m_EditorClassIdentifier: KBP.URDT.TestPoligon.Mechanics2D::KBP.URDT.TestPoligon.Mechanics2D.M10_TimedAccumulator.M10_TimedAccumulatorMechanic
  _mechanicId: M10_TimedAccumulator
  _title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 #10: \u0412\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u0438\u043D\u0442\u0435\u0433\u0440\u0430\u0442\u043E\u0440 \u0441 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0435\u043C
    \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D\u0430 (Timed Accumulator)"
  _instruction: "\u0417\u0430\u0436\u043C\u0438\u0442\u0435 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
    \u043A\u043D\u043E\u043F\u043A\u0443 \xAB\u041D\u0410\u041A\u0410\u0427\u041A\u0410\xBB.
    \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0432 \u0437\u0435\u043B\u0451\u043D\u043E\u043C
    \u0441\u0435\u043A\u0442\u043E\u0440\u0435 (70-85%). \u041F\u0435\u0440\u0435\u043A\u0430\u0447\u043A\u0430
    \u0432\u044B\u0448\u0435 90% \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
    \u043A \u0432\u0437\u0440\u044B\u0432\u0443!"
  _needleTransform: {fileID: 6914656315947563760}
  _holdButton: {fileID: 8326790326578991584}
  _pressureDisplay: {fileID: 7407597012084616189}
  _instructionText: {fileID: 4615657853277688494}
  _fillRate: 0.35
  _decayRate: 0.2
  _targetMin: 0.7
