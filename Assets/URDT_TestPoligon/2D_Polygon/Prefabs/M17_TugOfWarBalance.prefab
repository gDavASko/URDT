  _mechanicId: M17_TugOfWarBalance
  _title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 #17: \u0410\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440
