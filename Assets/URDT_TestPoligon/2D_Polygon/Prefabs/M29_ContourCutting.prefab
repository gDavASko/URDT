  m_Name: 
  m_EditorClassIdentifier: KBP.URDT.TestPoligon.Mechanics2D::KBP.URDT.TestPoligon.Mechanics2D.M29_ContourCutting.M29_ContourCuttingMechanic
  _mechanicId: M29_ContourCutting
  _title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 #29: \u0412\u044B\u0440\u0435\u0437\u0430\u043D\u0438\u0435
    \u043F\u043E \u043A\u043E\u043D\u0442\u0443\u0440\u0443 (Contour Scissor Cutting)"
  _instruction: "\u0412\u0435\u0434\u0438\u0442\u0435 \u043D\u043E\u0436\u043D\u0438\u0446\u0430\u043C\u0438
    \u0432\u0434\u043E\u043B\u044C \u043F\u0443\u043D\u043A\u0442\u0438\u0440\u043D\u043E\u0433\u043E
    \u043A\u043E\u043D\u0442\u0443\u0440\u0430 \u0437\u0432\u0435\u0437\u0434\u044B.
    \u041D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u044B
