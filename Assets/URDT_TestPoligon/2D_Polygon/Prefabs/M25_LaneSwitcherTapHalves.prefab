  _mechanicId: M25_LaneSwitcherTapHalves
  _title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 #25: \u0421\u0434\u0432\u0438\u0433
    \u043F\u043E \u043F\u043E\u043B\u043E\u0441\u0430\u043C \u2014 \u0422\u0430\u043F\u044B
    \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430\u043C (Lane Switcher:
    Half Taps)"
  _instruction: "\u041D\u0430\u0436\u0438\u043C\u0430\u0439\u0442\u0435 \u043D\u0430
    \u043B\u0435\u0432\u0443\u044E \u0438\u043B\u0438 \u043F\u0440\u0430\u0432\u0443\u044E
    \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u044D\u043A\u0440\u0430\u043D\u0430
    \u0434\u043B\u044F \u0441\u043C\u0435\u043D\u044B \u043F\u043E\u043B\u043E\u0441\u044B.
    \u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 5 \u043C\u043E\u043D\u0435\u0442
    \u0438 \u0438\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435 \u0431\u0430\u0440\u044C\u0435\u0440\u043E\u0432
    [X]!"
