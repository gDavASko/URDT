  m_EditorClassIdentifier: KBP.URDT.TestPoligon.Mechanics2D::KBP.URDT.TestPoligon.Mechanics2D.M03_WeightComparator.M03_WeightComparatorMechanic
  _mechanicId: M03_WeightComparator
  _title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 #3: \u0411\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u043A\u0430
    \u043C\u0430\u0441\u0441\u044B / \u0412\u0435\u0441\u043E\u0432\u043E\u0439 \u043A\u043E\u043C\u043F\u0430\u0440\u0430\u0442\u043E\u0440"
  _instruction: "\u0423\u0440\u0430\u0432\u043D\u043E\u0432\u0435\u0441\u044C\u0442\u0435
    \u0432\u0435\u0441\u044B. \u041D\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0440\u043E\u0432\u043D\u043E
    15 \u043A\u0433 \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u0439 \u0447\u0430\u0448\u0435
    (10\u043A\u0433 + 5\u043A\u0433). \u0418\u0437\u0431\u0435\u0433\u0430\u0439\u0442\u0435
    \u0433\u0438\u0440\u0438-\u043F\u0443\u0441\u0442\u044B\u0448\u043A\u0438 (X)!"
  _beamTransform: {fileID: 3082645079288742592}
