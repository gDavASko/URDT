    -> \u0412\u043F\u0435\u0440\u0435\u0434. \u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u0435
    \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0443 \u043A\u043D\u043E\u043F\u043A\u043E\u0439
    \xAB\u041F\u0423\u0421\u041A\xBB. \u041D\u0435 \u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u0444\u0438\u0448\u043A\u0443 \u0441\u043E \u0441\u0431\u043E\u0435\u043C (X)!"
