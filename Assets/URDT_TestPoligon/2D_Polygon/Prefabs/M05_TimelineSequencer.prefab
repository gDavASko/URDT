  _mechanicId: M05_TimelineSequencer
  _title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 #5: \u0421\u0431\u043E\u0440\u043A\u0430
    \u0438\u0441\u043F\u043E\u043B\u043D\u044F\u0435\u043C\u043E\u0439 \u043E\u0447\u0435\u0440\u0435\u0434\u0438
