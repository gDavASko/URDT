  m_Name: 
  m_EditorClassIdentifier: KBP.URDT.TestPoligon.Mechanics2D::KBP.URDT.TestPoligon.Mechanics2D.M28_DualBridgeRoute.M28_DualBridgeRouteMechanic
  _mechanicId: M28_DualBridgeRoute
  _title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 #28: \u041F\u043E\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u0441 \u043C\u043E\u0441\u0442\u0438\u043A\u0430\u043C\u0438
    (Dual Bridge Route)"
  _instruction: "\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u044B\u0435
    \u043C\u043E\u0441\u0442\u0438\u043A\u0438 \u0432 \u043F\u0440\u043E\u0432\u0430\u043B\u044B
