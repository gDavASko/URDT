  _mechanicId: M20_VerticalStacking
  _title: "\u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 #20: \u0421\u0432\u043E\u0435\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439
